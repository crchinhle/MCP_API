{
  "name": "@emukey/mobile",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "type": "module",
  "scripts": {
    "build": "expo export --platform android --output-dir dist",
    "e2e:maestro": "maestro test e2e/phase6-license-flow.yaml",
    "e2e:check": "node scripts/check-maestro.mjs",
    "lint": "eslint .",
    "openapi:check": "node scripts/generate-openapi.mjs --check",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "start": "expo start",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@expo-google-fonts/great-vibes": "0.4.1",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "expo": "~57.0.26",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "eslint": "10.9.1",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "prettier": "3.9.6",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
