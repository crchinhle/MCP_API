# Copy to .env and replace placeholders. Never commit the filled file.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
OTEL_ENABLED=false
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-random-secret-at-least-32-characters
SEED_PASSWORD=replace-with-development-password

# Local adapters; configure real providers explicitly for staging/production.
PAYMENT_ADAPTER=fake
PAYMENT_WEBHOOK_SECRET=replace-with-development-webhook-secret
AI_ADAPTER=fake
EMAIL_ADAPTER=fake
PUSH_ADAPTER=fake
STORAGE_ADAPTER=local
ACTIVATION_ENVELOPE_ADAPTER=redis
ACTIVATION_ENVELOPE_KEY=replace-with-64-hex-characters

# Start/deploy the local contract before API readiness can succeed.
# For containers, use the reachable chain hostname instead of 127.0.0.1.
EVM_ADAPTER=viem
EVM_NETWORK=hardhat
EVM_CHAIN_ID=31337
EVM_CONFIRMATIONS=2
EVM_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
EVM_DEPLOYMENT_BLOCK=1
EVM_INDEXER_BATCH_SIZE=500
EVM_RPC_HTTP_URL=http://127.0.0.1:8545
EVM_RELAYER_PRIVATE_KEY=replace-with-local-relayer-0x-prefixed-64-hex-key
PUBLIC_VERIFY_RATE_LIMIT_PER_MINUTE=30
PUBLIC_VERIFY_ID_MIN_LENGTH=20
