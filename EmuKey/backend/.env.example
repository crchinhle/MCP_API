# Copy to .env and replace placeholders. Never commit the filled file.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
OTEL_ENABLED=false
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-random-secret-at-least-32-characters
SEED_PASSWORD=replace-with-development-password

# Development runtime uses real providers. Replace every provider placeholder.
# fake adapters are allowed ONLY in NODE_ENV=test with disposable fixtures;
# they cannot start the normal development or production API/worker.
PAYMENT_ADAPTER=sepay
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=replace-with-sandbox-merchant-id
SEPAY_SECRET_KEY=replace-with-sandbox-secret-key
WEB_APP_URL=http://localhost:5173
AI_ADAPTER=gemini
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=replace-with-an-enabled-model-id
EMAIL_ADAPTER=brevo
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=replace-with-verified-sender@example.test
BREVO_SENDER_NAME=EmuKey Development
PUSH_ADAPTER=fcm
FCM_PROJECT_ID=replace-with-firebase-project-id
FCM_CLIENT_EMAIL=replace-with-service-account-email
# One-line PEM with escaped newlines; replace the entire quoted value.
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_SERVICE_ACCOUNT_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Local storage is development-only. Production requires Cloudinary credentials.
STORAGE_ADAPTER=local
# For production, select cloudinary and supply these instead:
# CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
# CLOUDINARY_API_KEY=replace-with-api-key
# CLOUDINARY_API_SECRET=replace-with-api-secret
# CLOUDINARY_FOLDER=emukey/knowledge
ACTIVATION_ENVELOPE_ADAPTER=redis
ACTIVATION_ENVELOPE_KEY=replace-with-64-hex-characters

# Blockchain runtime always uses Ethereum Sepolia, including local API/Worker runs.
EVM_ADAPTER=viem
EVM_NETWORK=sepolia
EVM_CHAIN_ID=11155111
EVM_CONFIRMATIONS=2
EVM_CONTRACT_ADDRESS=0x4d30200F3D0791e0aE34Fa6075A4e4b03f4d1cBC
EVM_DEPLOYMENT_BLOCK=11842365
# Optional namespace-aware registry; keep BOTH empty until its separate deployment is approved.
# Legacy registry settings above remain necessary for existing licenses.
EVM_NAMESPACE_CONTRACT_ADDRESS=
EVM_NAMESPACE_DEPLOYMENT_BLOCK=
EVM_INDEXER_BATCH_SIZE=500
EVM_RPC_HTTP_URL=https://sepolia-rpc-provider.example
EVM_RPC_FALLBACK_HTTP_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_RELAYER_PRIVATE_KEY=replace-with-sepolia-relayer-0x-prefixed-64-hex-key
PUBLIC_VERIFY_RATE_LIMIT_PER_MINUTE=30
PUBLIC_ACTIVATION_RATE_LIMIT_PER_MINUTE=30
PUBLIC_VERIFY_ID_MIN_LENGTH=20

# Provider key handoff: new purchases require a verified, enabled provider integration.
PROVIDER_HANDOFF_ENABLED=true
# Optional exact loopback receiver origin for local tests only; forbidden in production.
PROVIDER_TEST_ORIGIN=
