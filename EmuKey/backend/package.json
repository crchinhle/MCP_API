{
  "name": "@emukey/backend",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "type": "module",
  "scripts": {
    "db:initialize": "node --env-file-if-exists=.env dist/entrypoints/database/initialize.js",
    "db:reset": "node --env-file-if-exists=.env dist/entrypoints/database/reset.js",
    "db:seed": "node --env-file-if-exists=.env dist/entrypoints/database/seed.js",
    "db:verify": "node --env-file-if-exists=.env dist/entrypoints/database/verify.js",
    "reconcile:run": "node --env-file-if-exists=.env scripts/reconcile.mjs",
    "reconcile:payment:sandbox": "node --env-file-if-exists=.env scripts/reconcile-sandbox-payment.mjs",
    "lint": "eslint .",
    "openapi:export": "node --env-file-if-exists=.env dist/entrypoints/api/export-openapi.js",
    "start:api": "node --env-file-if-exists=.env dist/entrypoints/api/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/entrypoints/worker/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "secrets:rotate:dev": "node scripts/rotate-dev-secrets.mjs",
    "contracts:build": "corepack pnpm --dir contracts build && corepack pnpm --dir contracts abi:export",
    "openapi:check": "node scripts/generate-openapi.mjs --check",
    "openapi:generate": "node scripts/generate-openapi.mjs"
  },
  "dependencies": {
    "@getbrevo/brevo": "6.0.3",
    "@google/genai": "2.20.0",
    "@nestjs/axios": "12.0.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/platform-socket.io": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/websockets": "12.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "argon2": "0.45.1",
    "axios": "1.20.0",
    "bullmq": "6.3.4",
    "canonicalize": "4.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "5.11.1",
    "jose": "6.2.10",
    "nestjs-pino": "5.1.0",
    "pdf-parse": "2.4.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sepay-pg-node": "1.0.0",
    "socket.io": "4.8.3",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.0.1",
    "@swc/core": "1.16.1",
    "@testcontainers/postgresql": "12.0.4",
    "@testcontainers/redis": "12.0.4",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "testcontainers": "12.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11"
  }
}
